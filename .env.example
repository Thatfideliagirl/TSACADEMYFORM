# Copy this file to .env.local and fill in the values from Supabase, Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private settings. Never put these in browser code or commit them.
# The secret key from Supabase (called service_role or secret). Lets the app create accounts.
SUPABASE_SERVICE_ROLE_KEY=
# Only for creating the very first admin. Choose any long code. Stops working once an admin exists.
FIRST_ADMIN_EMAIL=
ADMIN_SETUP_CODE=
